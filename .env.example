# Copy to .env and adjust. Consumed by docker-compose.yml (docker compose
# reads .env automatically).

# Bind IP for the viewer web UI. On a server fronted by a reverse proxy set
# it to the docker bridge gateway (172.17.0.1) so only the proxy and
# co-hosted containers can reach the port — never the internet.
# Empty = all interfaces (local dev).
VIEWER_BIND_IP=

# Host port for the viewer web UI
VIEWER_PORT=8080

# Pin the archive to a host directory (browsable from the NAS / other tools).
# The directory must exist before `docker compose up`. Unset = named Docker
# volume kept inside /var/lib/docker/volumes.
#MEDIA_HOST_DIR=/srv/mergerfs/Pool1/Archive/Sakamichi Message

# --- syncer ---
# Cadence of full sync rounds (GNU sleep suffixes: m/h/d). Full rounds
# refresh the member roster, profile/single artwork, and heal edits,
# deletions and partial archives.
SYNC_INTERVAL=30m

# Optional probe rounds between full rounds (e.g. "3m"; unset = disabled).
# A probe fetches only the newest message per member (~1 KB) and runs the
# full sync just for members whose newest message is new or edited — new
# messages land within the probe interval at negligible API cost. Probes
# also carry the Uptime Kuma heartbeat, so a dead syncer pages within this
# interval rather than SYNC_INTERVAL.
#SYNC_PROBE_INTERVAL=3m

# Blogs ride on their own schedule (they're far rarer than messages): the
# phase piggybacks on the next sync round that's due, covering all sites in
# that pass. SYNC_BLOG=0 disables it entirely.
SYNC_BLOG=1
SYNC_BLOG_INTERVAL=1h

# Sites to sync, space separated: nogizaka46 sakurazaka46
SYNC_SITES=nogizaka46

# Extra grab-media flags for FULL rounds only (messages only). The first sync of a member with 200+ messages
# should use
#   SYNC_FLAGS=--full-history
# to walk the full timeline; afterwards routine rounds merge with the existing
# archive on disk, so this only needs re-adding to heal a partial archive.
SYNC_FLAGS=

# Optional: push failure/recovery notifications (ntfy / SMTP / webhook), e.g.
#   NOTIFY_URL=https://ntfy.sh/<your-private-topic>
#NOTIFY_URL=

# Uptime Kuma push monitor (heartbeat after every sync round; up on success,
# down on failure — and no heartbeat at all if the syncer died). Copy the
# push URL from the monitor's setup page; keep only the endpoint, the script
# appends its own status/msg/ping. Inside docker use host.docker.internal
# (the syncer maps it to the host gateway) instead of the server's hostname.
#   PUSH_URL=http://host.docker.internal:3001/api/push/<your-token>
#PUSH_URL=

# Bearer token for the session-cookie upload endpoint (session-upload.py).
# Unset = endpoint disabled. Generate with: openssl rand -hex 32
UPLOAD_TOKEN=

# Password for the Talk archive's login screen (the Blog tab stays public).
# Unset = no login gate — everything is public (local dev). The server signs
# a 30-day session cookie with a key derived from this password, so changing
# it also logs everyone out.
VIEWER_PASSWORD=
