# Copy to .env and adjust. Consumed by docker-compose.yml (docker compose
# reads .env automatically).

# Host port for the viewer web UI
VIEWER_PORT=8080

# --- syncer ---
# Sleep between sync rounds (GNU sleep suffixes: m/h/d)
SYNC_INTERVAL=6h

# Sites to sync, space separated: nogizaka46 sakurazaka46
SYNC_SITES=nogizaka46

# Extra grab-media flags. For the FIRST sync of a long archive use
#   SYNC_FLAGS=--full-history
# then clear it (routine syncs walk the newest 200 messages only).
SYNC_FLAGS=

# Optional: push failure/recovery notifications (ntfy / SMTP / webhook), e.g.
#   NOTIFY_URL=https://ntfy.sh/<your-private-topic>
#NOTIFY_URL=

# Uptime Kuma push monitor (heartbeat after every sync round; up on success,
# down on failure — and no heartbeat at all if the syncer died). Copy the
# push URL from the monitor's setup page; keep only the endpoint, the script
# appends its own status/msg/ping. Inside docker use host.docker.internal
# (the syncer maps it to the host gateway) instead of the server's hostname.
#   PUSH_URL=http://host.docker.internal:3001/api/push/<your-token>
#PUSH_URL=

# Bearer token for the session-cookie upload endpoint (session-upload.py).
# Unset = endpoint disabled. Generate with: openssl rand -hex 32
UPLOAD_TOKEN=
