# Template for deploy.env (gitignored — this machine's targets only).
# Copy to deploy.env and fill in; deploy.sh refuses to run without it.

# OMV server over Tailscale: user@host
SSH_TARGET="user@your-server.tailnet-name.ts.net"

# The server's appdata dir — also a git remote (`omv`) with
# receive.denyCurrentBranch=updateInstead, so `git push omv main` updates the
# working tree there directly.
APP_DIR="/srv/path/to/appdata/Sakamichi Archive"

# Public URL, echoed once the deploy's health poll passes
HEALTH_URL="https://your-public-url.example"

# Port the health-check hits on the server's docker bridge gateway
# (172.17.0.1) — the viewer port is intentionally not exposed publicly.
# Optional; defaults to 8484.
#VIEWER_PORT=8484
