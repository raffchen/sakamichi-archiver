# secrets & runtime state (tokens, cookies, captures — never commit)
logs/
chrome-profile/

# downloaded archive + generated viewer index/thumbs (rebuild with npm run index)
media/
viewer/public/index.json
viewer/public/index.sqlite*
# local design doc — deliberately not in the repo (see docs/search-db.md)
docs/search-db.md
viewer/public/thumbs/

# node / vite
node_modules/
viewer/dist/

# python
__pycache__/
*.pyc

# java/dex build artifacts from the SSL-unpinning experiment
tools/TlsTest.class
tools/classes.dex
TlsTest.class
classes.dex

# emulator-side stray output
*.dex

# session dumps & dev screenshots
pi-session-*.html
*.png
!docs/*.png

# OS junk
Thumbs.db
.DS_Store

# compose env (secrets/config — copy .env.example)
.env

# local working notes (not part of the repo)
docs/deployment.md

# deployment secrets (never commit)
ssh-creds.txt

# local-only dev tool (server cookie pull/push — not part of the repo)
tools/pull-secrets.sh

# api recorder (browser capture — local exploration tool)
tools/record-api.py
logs/api-capture-*.jsonl
logs/chrome-blog-profile/
*.jpg
